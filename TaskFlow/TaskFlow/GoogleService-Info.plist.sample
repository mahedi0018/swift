<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  TEMPLATE ONLY — this file contains placeholder values, not real credentials.

  Setup:
    1. Create a Firebase project and register an iOS app whose bundle ID matches
       the TaskFlow target (default: MMH.TaskFlow).
    2. Download the real GoogleService-Info.plist from the Firebase console.
    3. Copy it into this directory, replacing this template:
         cp GoogleService-Info.plist.sample GoogleService-Info.plist
    4. Do NOT commit GoogleService-Info.plist — it is already in .gitignore.

  Note: the GoogleService-Info.plist is bundled inside the .app and is therefore
  extractable by anyone who installs the app. It is not a server credential. Keep
  the key restricted by bundle ID in the Firebase console and enable App Check
  rather than relying on this file staying secret.
-->
<plist version="1.0">
<dict>
	<key>API_KEY</key>
	<string>YOUR_API_KEY</string>
	<key>GCM_SENDER_ID</key>
	<string>YOUR_GCM_SENDER_ID</string>
	<key>PLIST_VERSION</key>
	<string>1</string>
	<key>BUNDLE_ID</key>
	<string>YOUR_BUNDLE_ID</string>
	<key>PROJECT_ID</key>
	<string>YOUR_PROJECT_ID</string>
	<key>STORAGE_BUCKET</key>
	<string>YOUR_PROJECT_ID.firebasestorage.app</string>
	<key>GOOGLE_APP_ID</key>
	<string>1:YOUR_GCM_SENDER_ID:ios:YOUR_APP_ID</string>
	<key>CLIENT_ID</key>
	<string>YOUR_CLIENT_ID.apps.googleusercontent.com</string>
	<key>REVERSED_CLIENT_ID</key>
	<string>com.googleusercontent.apps.YOUR_CLIENT_ID</string>
	<key>IS_ADS_ENABLED</key>
	<false></false>
	<key>IS_ANALYTICS_ENABLED</key>
	<false></false>
	<key>IS_APPINVITE_ENABLED</key>
	<true></true>
	<key>IS_GCM_ENABLED</key>
	<true></true>
	<key>IS_SIGNIN_ENABLED</key>
	<true></true>
</dict>
</plist>
